# Database Driver: mongo | scylla
DB_DRIVER=mongo

# Chat Server
CHAT_WS_PORT=8888

# MongoDB (used when DB_DRIVER=mongo)
MONGO_DB_HOST=mongo
MONGO_DB_PORT=27017
MONGO_DB_USERNAME=chat_user
MONGO_DB_PASSWORD=chat_password
CHAT_DB=chat_db

# ScyllaDB (used when DB_DRIVER=scylla)
SCYLLA_HOSTS=scylla-cluster
SCYLLA_PORT=9042
SCYLLA_KEYSPACE=chat_ks
SCYLLA_USERNAME=
SCYLLA_PASSWORD=
SCYLLA_CONNECT_TIMEOUT=5s
SCYLLA_TIMEOUT=5s
SCYLLA_NUMCONNS=4

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# Gateway (Auth Service)
GATEWAY_URL=https://backend.shenakht.com

# RabbitMQ (optional)
RABBITMQ_USER=chat_rabbit
RABBITMQ_PASSWORD=chat_rabbit_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_QUEUE=chat.rooms
RABBITMQ_ENABLED=false

# MinIO (optional)
MINIO_ENDPOINT=185.7.212.23:19000
MINIO_ACCESS_KEY=dahaeehossein@gmail.com
MINIO_SECRET_KEY=sd6f413651@wW
MINIO_BUCKET=chat
MINIO_USE_SSL=false
MINIO_OBJECT_PREFIX=chat

# Mock Users
MOCK_USERS_ENABLED=0

# Logging
LOG_LEVEL=info

# LiveKit
LIVEKIT_API_KEY=prodkey
LIVEKIT_API_SECRET=prodsecret
LIVEKIT_URL=http://livekit:7880
