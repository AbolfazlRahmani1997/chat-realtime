# سرور چت
CHAT_WS_PORT=8080

# MongoDB
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_DB_USERNAME=your_user
MONGO_DB_PASSWORD=your_password
CHAT_DB=chat_db
MAIN_DB=main_db

# نام collectionها
MESSAGE_COLLECTION=messages
ROOM_COLLECTION=rooms

# سرویس احراز هویت (Gateway)
GATEWAY_URL=http://localhost:8000

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_QUEUE=chat.rooms

# یوزرهای ماک (فقط برای dev؛ true = فعال)
MOCK_USERS_ENABLED=false
MOCK_USERS_FILE=config/mock_users.json

# Kafka (اختیاری) — اگر KAFKA_ENABLED=true باشد، پیام‌ها به جای نوشتن مستقیم در دیتابیس
# از طریق Kafka به consumerها ارسال شده و در دیتابیس ذخیره می‌شوند.
# اگر false باشد، پیام‌ها مستقیماً در دیتابیس نوشته می‌شوند (رفتار قبلی).
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_MESSAGES_TOPIC=chat.messages
KAFKA_CONSUMER_GROUP=chat-writers

# MinIO (اختیاری) — اگر MINIO_ENDPOINT خالی باشد، فایل‌ها روی دیسک محلی ذخیره می‌شوند.
# فقط host:port (بدون http/https). در Docker پیش‌فرض API روی 9000 است؛ 9001 معمولاً «کنسول وب» است نه S3 API — اگر 9001 بگذاری خطای timeout می‌گیری.
# می‌توانی با https://host:port بنویسی؛ در آن حالت TLS از روی URL هم فعال می‌شود.
MINIO_ENDPOINT=188.121.159.38:900
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chat
MINIO_USE_SSL=false
# زمان انتظار اتصال اولیه به MinIO (ثانیه) — پیش‌فرض 120
# MINIO_CONNECT_TIMEOUT_SECONDS=120
# MINIO_REGION=
# پیشوند object در bucket (مثلاً chat/)
# MINIO_OBJECT_PREFIX=
# مدت لینک دانلود امضاشده (ثانیه) — پیش‌فرض 86400
# MINIO_PRESIGN_SECONDS=86400
# پوشهٔ محلی وقتی MinIO غیرفعال است:
# CHAT_UPLOAD_DIR=./uploads
#
# برای پخش صوت/فایل در مرورگر وقتی GET به presigned MinIO ریدایرکت می‌شود، روی bucket در MinIO CORS را برای origin فرانت تنظیم کنید.
